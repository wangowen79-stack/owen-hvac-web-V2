# ── Owen HVAC Backend Environment Variables ──

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/owenhvac?retryWrites=true&w=majority

# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin authentication
ADMIN_SECRET=your-secret-admin-token-here

# Email notifications (Gmail)
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
NOTIFY_EMAIL=info@owenhvac.ca

# Frontend URL (for CORS)
FRONTEND_URL=https://owen-hvac-web.onrender.com

# Port
PORT=4000
